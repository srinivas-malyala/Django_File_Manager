# Core Django configuration
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
APPLICATION_VERSION=1.0

# Database (empty uses SQLite; production example shown below)
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0
DATABASE_CONN_HEALTH_CHECKS=False
# DATABASE_URL=postgresql://filemanager:encoded-password@db:5432/filemanager?sslmode=require

# Cache (use a shared backend when running multiple production replicas)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=file-manager-cache
CACHE_TIMEOUT=300

# Static and private uploaded file locations
STATIC_ROOT=
MEDIA_ROOT=
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# Configurable fixed-window browser throttles
REGISTRATION_RATE_LIMIT=20
LOGIN_RATE_LIMIT=20
PASSWORD_RESET_RATE_LIMIT=20
FILE_UPLOAD_RATE_LIMIT=60
FILE_SEARCH_RATE_LIMIT=120

# Django REST Framework throttles
TOKEN_API_THROTTLE_RATE=20/minute
FILE_UPLOAD_API_THROTTLE_RATE=60/minute
FILE_SEARCH_API_THROTTLE_RATE=120/minute

# Password reset and email configuration
PASSWORD_RESET_TIMEOUT=3600
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Production security (development can keep these false/empty)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CSRF_TRUSTED_ORIGINS=
TRUST_X_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING
LOG_FORMAT=standard

# Gunicorn
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
# Access logging is disabled by default to avoid recording reset-token URLs.
GUNICORN_ACCESS_LOG=
